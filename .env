# ==========================================================================
# Rebuild — production environment variables for Vercel.
# Copy these into your Vercel project: Settings → Environment Variables.
# DO NOT commit real secrets. This file contains placeholders/empty values that
# keep the app in DEMO mode and are safe to publish.
#
# The ONE hard requirement for Vercel is a managed PostgreSQL DATABASE_URL
# (SQLite file storage does not persist on the serverless runtime).
# ==========================================================================

# --- App / Site -----------------------------------------------------------
# Set AFTER your deployment URL exists (no trailing slash).
APP_URL="https://your-app.vercel.app"
PRODUCT_NAME="Rebuild"
PRODUCT_PRICE_AMOUNT="4900"
PRODUCT_PRICE_CURRENCY="USD"
NEXT_PUBLIC_PRICE_DISPLAY="$49"

# --- Database (PostgreSQL) ------------------------------------------------
# Use Neon / Supabase / Vercel Postgres. Required.
DATABASE_URL="postgresql://neondb_owner:npg_7Z2AfaDsqREK@ep-crimson-hall-az9wuif9-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# --- Storage driver for media / eBook uploads -----------------------------
# "vercel" = durable Vercel Blob (requires the token below).
# "local"  = server disk (ephemeral on Vercel; only for quick tests).
STORAGE_DRIVER="vercel"
BLOB_READ_WRITE_TOKEN=""

# --- Initial super-admin (only used by `npm run db:seed:pg`) --------------
ADMIN_EMAIL="admin@gmail.com"
ADMIN_PASSWORD="Aa123123v@"

# --- Payments -------------------------------------------------------------
PAYMENT_MODE="demo"               # "live" when real credentials are set below
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox"
WISE_PAYMENT_FLOW="manual"
WISE_BENEFICIARY_NAME=""
WISE_ACCOUNT_NUMBER=""
WISE_BANK_NAME=""
WISE_IBAN=""
WISE_SWIFT=""
WISE_INSTRUCTIONS="Pay to the account shown on the next step, then paste your reference/order ID as proof of payment."

# --- Email ----------------------------------------------------------------
# "smtp" sends real email; "console" logs to Vercel function logs.
EMAIL_TRANSPORT="smtp"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
EMAIL_FROM="Rebuild <support@company.com>"
EMAIL_SUPPORT="support@company.com"

# --- Delivery / secure download ------------------------------------------
# Change this to a long random value (32+ chars) before going live.
ACCESS_TOKEN_SECRET="change-me-in-production-please-use-32-plus-random-chars"
EBOOK_DOWNLOAD_URL=""
SECURE_DOWNLOAD="true"
DOWNLOAD_LINK_TTL="900"

# --- Analytics ------------------------------------------------------------
ANALYTICS_PROVIDER="none"
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="30"
