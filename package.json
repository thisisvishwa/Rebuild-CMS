{
  "name": "rebuild-recovery-ebook",
  "version": "1.0.0",
  "private": true,
  "description": "A premium landing page and secure digital-delivery system for the 'Rebuild' breakup & divorce recovery eBook.",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:sync-postgres": "node scripts/sync-postgres-schema.mjs",
    "db:push:pg": "prisma db push --schema prisma/schema.postgresql.prisma",
    "db:generate:pg": "prisma generate --schema prisma/schema.postgresql.prisma",
    "db:seed:pg": "tsx prisma/seed.ts",
    "db:setup:pg": "prisma db push --schema prisma/schema.postgresql.prisma && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.441.0",
    "next": "14.2.35",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.1",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.28",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
