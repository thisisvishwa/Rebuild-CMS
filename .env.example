# ==========================================================================
# Rebuild — Breakup & Divorce Recovery eBook
# Environment configuration.
#
# Copy this file to `.env.local` for local development, and to your hosting
# provider's environment variables in production. NEVER commit real secrets.
#
# All values below are SAFE PUBLICATION VARIABLES — empty/placeholder values
# put the app into DEMO mode so the entire purchase → access → download flow
# can be tested locally without any live payment credentials.
# ==========================================================================

# --------------------------------------------------------------------------
# App / Site
# --------------------------------------------------------------------------
APP_URL="http://localhost:3000"
PRODUCT_NAME="Rebuild"

# --------------------------------------------------------------------------
# Pricing — single source of truth.
# PRICE_AMOUNT is in the smallest currency unit (e.g. cents/paisa).
# --------------------------------------------------------------------------
PRODUCT_PRICE_AMOUNT="4900"
PRODUCT_PRICE_CURRENCY="USD"
# Optional override used on the front end (helps avoid float bugs):
NEXT_PUBLIC_PRICE_DISPLAY="$49"

# --------------------------------------------------------------------------
# Payments
# --------------------------------------------------------------------------
# "demo"  → simulated checkout so you can test the full flow with no credentials
# "live"  → real processors (requires the per-provider credentials below)
PAYMENT_MODE="demo"

# --- Razorpay (cards / UPI / netbanking) -----------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# --- PayPal ----------------------------------------------------------------
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# "sandbox" for development, "live" for production
PAYPAL_ENV="sandbox"

# --- Wise (manual / configurable flow) -------------------------------------
# "manual" → customer pays to the instructions below, then submits proof for
#            admin verification + manual/delayed fulfilment.
# "automated" → reserve this ONLY if a real Wise automated integration exists.
WISE_PAYMENT_FLOW="manual"
WISE_BENEFICIARY_NAME=""
WISE_ACCOUNT_NUMBER=""
WISE_BANK_NAME=""
WISE_IBAN=""
WISE_SWIFT=""
# Markdown text shown on the Wise payment instructions step.
WISE_INSTRUCTIONS="Pay to the account shown on the next step, then paste your reference/order ID as proof of payment. Access is granted once your payment is verified."

# --------------------------------------------------------------------------
# Database (Prisma)
# Default is a zero-configuration SQLite file so it runs on any Windows/Linux
# machine out of the box. For production point this at PostgreSQL, e.g.:
# DATABASE_URL="postgresql://user:pass@host:5432/db?schema=public"
# --------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# --------------------------------------------------------------------------
# Email (transactional). Set EMAIL_TRANSPORT="smtp" to send real email.
# In local/dev, "console" prints emails to the server log instead.
# --------------------------------------------------------------------------
EMAIL_TRANSPORT="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
EMAIL_FROM="Rebuild <support@example.com>"
EMAIL_SUPPORT="support@example.com"

# --------------------------------------------------------------------------
# Digital access / delivery
# eBook asset: either a static store URL or an S3/CDN object.
# If you host the file on this app, see `/public/protected` (gitignored) and
# keep SECURE_DOWNLOAD=true so downloads are signed/expiring.
# --------------------------------------------------------------------------
# PUBLIC asset (only used when SECURE_DOWNLOAD is false)
EBOOK_DOWNLOAD_URL=""
SECURE_DOWNLOAD="true"
# Lifetime of a signed download link, in seconds (default 15 mins).
DOWNLOAD_LINK_TTL="900"
# Secret used to sign access/download tokens. MUST change in production.
ACCESS_TOKEN_SECRET="change-me-in-production-please-use-32-plus-random-chars"

# --------------------------------------------------------------------------
# Analytics (optional). Provider "none" sends nothing.
# NEXT_PUBLIC_* vars are visible to the browser and must never hold secrets.
# --------------------------------------------------------------------------
ANALYTICS_PROVIDER="none"
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# --------------------------------------------------------------------------
# Rate limiting / security tuning
# --------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="30"

# --------------------------------------------------------------------------
# VERCEL / PRODUCTION DEPLOYMENT
# --------------------------------------------------------------------------
# On Vercel the function filesystem is read-only + ephemeral, so:
#   - Use a managed PostgreSQL database (Neon / Supabase / Vercel Postgres).
#     Set DATABASE_URL to its connection string AND run against the
#     Postgres schema: `npm run db:sync-postgres` then `npm run db:push:pg`
#     (or `prisma migrate deploy --schema prisma/schema.postgresql.prisma`).
#   - File uploads must use persistent object storage, not the server disk.
# --------------------------------------------------------------------------
# Storage driver for media/eBook uploads: "local" (disk) or "vercel" (Blob).
STORAGE_DRIVER="local"
# Vercel Blob read-write token (required when STORAGE_DRIVER=vercel).
# Get it with `vercel blob store add` or the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=""
# Seed the initial super-admin on first deploy (only used by db:seed).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
